<odoo>
    <record id="service_agreement_form" model="ir.ui.view">
        <field name="model">service.agreement</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group name="main" col="2">
                        <field name="name" />
                        <field name="code" />
                        <field name="product_ids" widget="many2many_tags" colspan="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="service_agreement_list" model="ir.ui.view">
        <field name="model">service.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="code" />
                <field name="product_ids" optional="show" />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="show"
                    readonly="1"
                />
            </list>
        </field>
    </record>

    <record id="service_agreement_search" model="ir.ui.view">
        <field name="model">service.agreement</field>
        <field name="arch" type="xml">
            <search>
                <filter name="name" />
                <filter name="code" />
            </search>
        </field>
    </record>

    <record id="service_agreement_action" model="ir.actions.act_window">
        <field name="name">Services Agreements</field>
        <field name="res_model">service.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="path">service-agreements</field>
    </record>

    <menuitem
        id="service_agreement_menu"
        parent="sale.menu_sale_config"
        sequence="1"
        action="service_agreement_action"
    />
</odoo>
