<odoo noupdate="0">
    <record id="data_map_found_animal" model="data.map">
        <field name="model_id" ref="model_pet_declaration" />
        <field name="code">Animal trouvé</field>
        <field name="transformation">vigipet_found</field>
        <field name="matching_field_id" ref="vigipet.vigipet_matching_field" />
        <field name="flow">import</field>
    </record>

    <record id="data_map_lost_animal" model="data.map">
        <field name="model_id" ref="model_pet_declaration" />
        <field name="code">Animal perdu</field>
        <field name="flow">import</field>
        <field name="transformation">vigipet_lost</field>
        <field name="matching_field_id" ref="vigipet.vigipet_matching_field" />
        <field name="config" />
    </record>
</odoo>
