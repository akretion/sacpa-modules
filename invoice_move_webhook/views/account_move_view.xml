<odoo>
    <record id="account_move_form_webhook" model="ir.ui.view">
        <field name="name">account.move.form.webhook</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <notebook>
                <page id="webhook_tab" name="webhook tab" string="Webhook information">
                    <group name="webhook_info">
                        <field
                            name="state_webhook"
                            string="Etat demat"
                            widget="status Bar"
                        />
                        <field
                            name="webhook_id"
                            string="webhook lier"
                            domain="[('partner_id', '=', partner_id), ('reference_de_la_commande', 'ilike', sale_order_id.name)]"
                        />
                        <field name="ttc_ok" readonly="True" string="Montant TTC OK" />
                        <field name="tva_ok" readonly="True" string="Montant TVA OK" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
