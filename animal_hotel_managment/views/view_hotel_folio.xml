<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Action for pension folio -->
    <record id="open_pension_folio1_form_tree_all" model="ir.actions.act_window">
        <field name="name">Generate pension Folio</field>
        <field name="res_model">hotel.folio</field>
        <field name="domain">["|",("job_type", "=", False), ("job_type", "=", "pension")]</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="context">{'folio': True}</field>
    </record>
    <!-- Action for fourriere folio -->
    <record id="open_fourriere_folio1_form_tree_all" model="ir.actions.act_window">
        <field name="name">Generate fourriere Folio</field>
        <field name="res_model">hotel.folio</field>
        <field name="domain">["|",("job_type", "=", False), ("job_type", "=", "fourriere")]</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="context">{'folio': True}</field>
    </record>
    <!-- Action for refuge folio -->
    <record id="open_refuge_folio1_form_tree_all" model="ir.actions.act_window">
        <field name="name">Generate refuge Folio</field>
        <field name="res_model">hotel.folio</field>
        <field name="domain">["|",("job_type", "=", False), ("job_type", "=", "refuge")]</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="context">{'folio': True}</field>
    </record>
    <record id="hotel_folio_formç_animal" model="ir.ui.view">
        <field name="model">hotel.folio</field>
        <field name="inherit_id" ref="hotel.view_hotel_folio_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="animal_id" string="Animal"/>
                <field name="company_id" string="Société" />
                <field name="job_type" string="Type métier" />
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="invisible">1</attribute>
            </field>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
