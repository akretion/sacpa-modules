        <field name="view_mode">list,form,calendar,graph</field>
        <field name="context">{'folio': True}</field>
    </record>
    <!-- Action for refuge folio -->
    <record id="open_refuge_folio1_form_tree_all" model="ir.actions.act_window">
        <field name="name">Generate refuge Folio</field>
        <field name="res_model">hotel.folio</field>
        <field name="domain">[("type_folio", "=", "refuge")]</field>
        <field name="view_mode">list,form,calendar,graph</field>
        <field name="context">{'folio': True}</field>
    </record>
</odoo>
