<odoo>
    <!-- Action for Room Reservation Summary -->
    <record id="action_pension_reservation_summary" model="ir.actions.act_window">
        <field name="name">Reservation Summary</field>
        <field name="res_model">room.reservation.summary</field>
        <field name="domain">[("job_type", "=", "pension")]</field>
        <field name="view_mode">form</field>
    </record>
    <record id="action_fourriere_reservation_summary" model="ir.actions.act_window">
        <field name="name">Reservation Summary</field>
        <field name="res_model">room.reservation.summary</field>
        <field name="domain">[("job_type", "=", "fourriere")]</field>
        <field name="view_mode">form</field>
    </record>
    <record id="action_refuge_reservation_summary" model="ir.actions.act_window">
        <field name="name">Reservation Summary</field>
        <field name="res_model">room.reservation.summary</field>
        <field name="domain">[("job_type", "=", "refuge")]</field>
        <field name="view_mode">form</field>
    </record>
    <!-- Action of hotel reservation -->
    <record id="action_pension_reservation_tree_all" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.reservation</field>
        <field name="domain">[("job_type", "=", "pension")]</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="action_fourriere_reservation_tree_all" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.reservation</field>
        <field name="domain">[("job_type", "=", "fourriere")]</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="action_refuge_reservation_tree_all" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hotel.reservation</field>
        <field name="domain">[("job_type", "=", "refuge")]</field>
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="view_form_hotel_reservation_animal" model="ir.ui.view">
        <field name="name">form.hotel.reservation.animal</field>
        <field name="model">hotel.reservation</field>
        <field name="inherit_id" ref="hotel_reservation.view_hotel_reservation_form"/>
        <field name="arch" type="xml">
            <field name="adults" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="children" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="adults" position="before">
                <field name="animal_id" string="Animal" readonly="state != 'draft'" />
            </field>
        </field>
    </record>
</odoo>
