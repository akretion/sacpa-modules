<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_requester_list" model="ir.ui.view">
        <field name="model">helpdesk.requester</field>
        <field name="arch" type="xml">
            <list string="Donneurs d'ordre">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_requester_form" model="ir.ui.view">
        <field name="model">helpdesk.requester</field>
        <field name="arch" type="xml">
            <form string="Donneur d'ordre">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_requester" model="ir.actions.act_window">
        <field name="name">Donneurs d'ordre</field>
        <field name="res_model">helpdesk.requester</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_requester"
              name="Donneurs d'ordre"
              parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
              action="action_helpdesk_requester"/>

</odoo>
