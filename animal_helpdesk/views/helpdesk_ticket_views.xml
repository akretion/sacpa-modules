<odoo>

    <record id="helpdesk_ticket_view_sacpa" model="ir.ui.view">
        <field name="name" >helpdesk.ticket.form.sacpa</field>
        <field name="model">helpdesk.ticket</field>
        <field name="priority" eval="1"/>
        <!-- <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/> -->
        <field name="arch" type="xml">
            <form string="Helpdesk Ticket">
                <header>
                    <button
                        string="Assign to me"
                        name="assign_to_me"
                        type="object"
                        invisible="user_id"
                    />
                    <button
                        string="Mark as duplicate"
                        name="action_open_duplicate_wizard"
                        type="object"
                        invisible="duplicate_id or duplicate_ids or not duplicate_tracking_enabled"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar_duration"
                        options="{'clickable': '1', 'fold_field': 'fold'}"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <widget
                        name="web_ribbon"
                        title="Duplicate"
                        bg_color="bg-danger"
                        invisible="not duplicate_id"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            type="object"
                            name="action_view_duplicates"
                            icon="fa-clone"
                            invisible="duplicate_count == 0"
                        >
                            <field
                                string="Duplicates"
                                name="duplicate_count"
                                widget="statinfo"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <div
                            class="alert alert-info oe_edit_only"
                            role="alert"
                            name="warning_duplicate"
                            invisible="not duplicate_id"
                        > This ticket is a
                            duplicate of <field
                            name="duplicate_id"
                            readonly="stage_id.closed"
                        />
                        </div>
                        <h1 class="oe_title">
                            <field name="name"  />
                        </h1>
                        <!-- <h2 class="o_row"> -->
                        <!--     <field name="name" /> -->
                        <!-- </h2> -->
                    </div>
                    <group name="main" col="2">
                        <group col="1">
                            <group>
                                <field name="number" string="Numéro de la demande"/>
                                <field name="create_date" string="Date/heure de la demande" />
                            </group>
                            <group string="QUI ?">
                                <field name="canal_demande"/>
                                <field name="partner_id" />
                                <field name="agreement_id" string="Contrat" />
                                <field name="donneur_ordre" string="Donneur d'ordre Type(liste déroulante)"/>
                                <field name="donneur_partner" string="Donneur d'ordre Contact"/>
                            </group>
                            <group string="QUAND ?">
                                <field name="priority" string="Priorité"/>
                                <field name="fsm_order_date" string="Date/heure de l'interventions" />
                            </group>
                            <group string="QUOI ?">
                                <field name="nature_id" string="Nature" />
                                <field name="description" string="Description" />
                            </group>
                            <group>
                                <field name="active" invisible="1" />
                                <field name="duplicate_tracking_enabled" invisible="1" />
                                <field name="team_id" options='{"always_reload": True}' />
                                <field name="user_ids" invisible="1" readonly="1" />
                                <field
                                    name="user_id"
                                    options='{"always_reload": True}'
                                    widget="many2one_avatar_user"
                                />
                                <field name="priority" widget="priority" />
                                <field
                                    name="company_id"
                                    options="{'no_create': True}"
                                    groups="base.group_multi_company"
                                />
                                <field name="create_date" readonly="1" />
                                <field name="channel_id" />

                            </group>
                        </group>
                        <group col="1">
                            <group string="OU ?">
                                <field name="fsm_location_id" />
                                <field name="location_address"/>
                                <field name="location_address2" />
                                <field name="location_zip"/>
                                <field name="location_city"/>
                                <div>
                                    <button icon="fa-gear" string="Compute based on address" title="Compute Localization" name="geo_localize" type="object" class="btn btn-link p-0"/>
                                </div>
                                <div>
                                    <button string="Liem google map" name="action_open_google_map"/>
                                </div>
                                <field name="contact_on_place" />
                                <field name="contact_phone" />
                                <field name="infos_localisation" />
                                <field name="blood" widget="Toggle"/>
                            </group>
                            <group string="COMMENT ?">
                                <field name="company_id" string="Société" />
                                <field name="team_id" string="Affecté à" />
                                <field name="fsm_vhl" string="Véhicule" />
                            </group>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page name="Animaux" string="Animaux">
                                <field name="animal_ids" >
                                    <list string="List animaux" open_form_view="True">
                                        <field name="name"/>
                                        <field name="species_id" />
                                        <field name="breed_id" />
                                        <field name="is_crossed" />
                                        <field name="status_id" />
                                    </list>
                                </field>
                            </page>
                            <page name="List_intervention" String="Liste des interventions">
                                <field name="fsm_order_ids" string="List des interventions">
                                    <list string="List des interventions">
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Autres informations" name="Autres informations">
                                <field name="notes" string="Notes"/>
                                <field name="description" string="Description" />
                            </page>
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
