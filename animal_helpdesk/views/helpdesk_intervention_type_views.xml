<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_helpdesk_intervention_type_list" model="ir.ui.view">
        <field name="model">helpdesk.intervention.type</field>
        <field name="arch" type="xml">
            <list string="Natures d'intervention">
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <record id="view_helpdesk_intervention_type_form" model="ir.ui.view">
        <field name="model">helpdesk.intervention.type</field>
        <field name="arch" type="xml">
            <form string="Nature d'intervention">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_helpdesk_intervention_type" model="ir.actions.act_window">
        <field name="name">Natures d'intervention</field>
        <field name="res_model">helpdesk.intervention.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_helpdesk_intervention_type"
        name="Natures d'intervention"
        parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
        action="action_helpdesk_intervention_type"
    />
</odoo>
