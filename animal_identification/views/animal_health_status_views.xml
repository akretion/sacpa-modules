<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste -->
    <record id="view_animal_health_status_list" model="ir.ui.view">
        <field name="model">animal.health.status</field>
        <field name="arch" type="xml">
            <list string="États sanitaires">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire -->
    <record id="view_animal_health_status_form" model="ir.ui.view">
        <field name="model">animal.health.status</field>
        <field name="arch" type="xml">
            <form string="État sanitaire">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action pour menu -->
    <record id="action_animal_health_status" model="ir.actions.act_window">
        <field name="name">États sanitaires</field>
        <field name="res_model">animal.health.status</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
