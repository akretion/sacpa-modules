<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_species_tree" model="ir.ui.view">
        <field name="model">animal.species</field>
        <field name="arch" type="xml">
            <list string="Espèces">
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <record id="view_species_form" model="ir.ui.view">
        <field name="model">animal.species</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_species" model="ir.actions.act_window">
        <field name="name">Espèces</field>
        <field name="res_model">animal.species</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
