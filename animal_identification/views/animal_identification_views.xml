<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_animal_tree" model="ir.ui.view">
        <field name="model">animal.identification</field>
        <field name="arch" type="xml">
            <list string="Identification Animal">
                <field name="fiche_number" />
                <field name="name" />
                <field name="specie_id" />
                <field name="breed_id" />
                <field name="gender" />
            </list>
        </field>
    </record>
    <record id="view_animal_form" model="ir.ui.view">
        <field name="model">animal.identification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="fiche_number" />
                    <group>
                        <group string="Infos animal">
                            <field name="coaxis_id" />
                            <field name="specie_id" />
                            <field name="breed_id" />
                            <field name="is_crossed" />
                            <field name="breed2_id" invisible="not is_crossed" />
                        </group>
                        <group string="Identification">
                            <field name="chip_number" />
                            <field name="tattoo_number" />
                            <field name="medal_number" />
                            <field name="name" />
                            <field name="gender" />
                            <field name="is_sterilized" />
                        </group>

                        <group string="Age de l'animal">
                            <field name="birth_date" />
                            <field name="calculated_age" />
                            <div>
                                <span class="fw-bold">ou Age estimer entre : </span>
                                <div class="row mt-2">
                                    <div class="col-3">
                                        <label
                                            string="Mois min"
                                            for="estimated_age_min_month"
                                        />
                                        <field
                                            name="estimated_age_min_month"
                                            placeholder="0-11"
                                        />
                                    </div>
                                    <div class="col-3">
                                        <label
                                            string="Année min"
                                            for="estimated_age_min_year"
                                        />
                                        <field
                                            name="estimated_age_min_year"
                                            placeholder="ex: 2"
                                        />
                                    </div>
                                    <div class="row">
                                        <span class="fw-bold">ET</span>
                                    </div>
                                    <div class="col-3">
                                        <label
                                            string="Mois max"
                                            for="estimated_age_max_month"
                                        />
                                        <field
                                            name="estimated_age_max_month"
                                            placeholder="0-11"
                                        />
                                    </div>
                                    <div class="col-3">
                                        <label
                                            string="Année max"
                                            for="estimated_age_max_year"
                                        />
                                        <field
                                            name="estimated_age_max_year"
                                            placeholder="ex: 5"
                                        />
                                    </div>
                                </div>
                            </div>
                            <field name="estimation_date" />
                        </group>
                        <group string="Caractéristiques">
                            <field name="size" />
                            <field name="ears" />
                            <field name="tail" />
                            <field name="hair" />
                            <field name="color1" />
                            <field name="color2" />
                            <field name="color3" />
                            <field name="color4" />
                            <field name="pattern" />
                        </group>
                    </group>
                    <notebook>
                        <page name="page_photo" string="Photos" />
                        <page name="page_documents" string="Documents" />
                        <page name="page_detenteurs" string="Détenteurs">
                            <field name="owner_ids">
                                <list string="Propriétaire" open_form_view="True">
                                    <field name="partner_id" />
                                    <field name="name" />
                                    <field name="city" />
                                    <field name="start_date" />
                                    <field name="legal" />
                                </list>
                            </field>
                        </page>
                        <page name="page_interventions" string="Interventions">
                            <field name="fsm_order_ids">
                                <list string="Interventions" open_form_view="True">
                                    <field name="name" />
                                    <!-- <field name="nature" /> -->
                                    <field name="date_start" />
                                    <!-- <field name="state" /> -->
                                </list>
                            </field>
                        </page>
                        <page name="page_folio" string="Folio / Dossiers">
                            <field name="folio_ids">
                                <list string="Folio-Dossier">
                                    <field name="name" />
                                    <field name="job_type" />
                                    <field name="animal_id" />
                                </list>
                            </field>
                        </page>
                        <page name="page_sanitaire" string="Etats sanitaire">
                            <field name="status_id">
                                <list string="Etats sanitaire">
                                    <field name="event_date" />
                                    <field name="event" />
                                    <field name="value" />
                                </list>
                            </field>
                        </page>
                        <page name="page_comportement" string="Comportement">
                            <field name="behavior_id">
                                <list string="Comportement">
                                    <field name="event_date" />
                                    <field name="event" />
                                    <field name="value" />
                                </list>
                            </field>
                        </page>
                        <page name="page_poids" string="Poids">
                            <field name="weight_ids">
                                <list string="Courbe de poids">
                                    <field name="event_date" />
                                    <field name="value" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                        <page name="page_protocoles" string="Protocoles">
                            <field name="protocol_ids">
                                <list string="Liste des protocole">
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="event_date" />
                                </list>
                            </field>
                        </page>
                        <page name="page_visites" string="Visites">
                            <field name="visit_ids">
                                <list string="Liste des visit">
                                    <field name="partner_id" string="Vétérinaire" />
                                    <field name="date" />
                                </list>
                            </field>
                        </page>
                        <page name="page_actes" string="Actes" />
                        <page name="page_traitement" string="Traitements">
                            <field name="treatment_ids">
                                <list string="Liste des traitement">
                                    <field name="name" />
                                    <field name="start_date" />
                                    <field name="end_date" />
                                    <field name="medic" />
                                    <field name="medic_nb" />
                                    <field name="fq_time" />
                                    <field name="duration" />
                                    <field name="comment" />
                                </list>
                            </field>
                        </page>
                        <page name="page_soin" string="Soins">
                            <field name="care_ids">
                                <list string="List des soins">
                                    <field name="name" />
                                    <field name="date" />
                                    <field name="animal_id" />
                                    <field name="value" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_animal_identification" model="ir.actions.act_window">
        <field name="name">Fiches</field>
        <field name="res_model">animal.identification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
