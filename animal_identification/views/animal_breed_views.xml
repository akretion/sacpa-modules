<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_breed_tree" model="ir.ui.view">
        <field name="model">animal.breed</field>
        <field name="arch" type="xml">
            <list string="Races">
                <field name="name" />
                <field name="code" />
                <field name="specie_id" />
            </list>
        </field>
    </record>

    <record id="view_breed_form" model="ir.ui.view">
        <field name="model">animal.breed</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="code" />
                        <field name="specie_id" />
                        <field name="code_group" />
                        <field name="code_scc" />
                        <field name="classification" />
                        <field name="categorie" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_breed" model="ir.actions.act_window">
        <field name="name">Races</field>
        <field name="res_model">animal.breed</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
