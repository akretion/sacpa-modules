<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_status_tree" model="ir.ui.view">
        <field name="model">animal.status</field>
        <field name="arch" type="xml">
            <list string="Statuts Animal">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_status_form" model="ir.ui.view">
        <field name="model">animal.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_status" model="ir.actions.act_window">
        <field name="name">Statut Animal</field>
        <field name="res_model">animal.status</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
