<odoo>
    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form.box</field>
        <field name="model">hotel.room</field>
        <field name="inherit_id" ref="hotel.view_hotel_room_form" />
        <field name="arch" type="xml">
            <field name="isroom" position="after">
                <field name="company_id" string="Société" />
            </field>
        </field>
    </record>
    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.form.box.type</field>
        <field name="model">hotel.room.type</field>
        <field name="inherit_id" ref="hotel.view_hotel_room_type_form" />
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="job_type" string="Type métier" />
            </field>
        </field>
    </record>
</odoo>
